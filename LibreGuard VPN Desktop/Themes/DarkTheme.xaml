<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core palette -->
    <Color x:Key="PrimaryColor">#60A5FA</Color>
    <Color x:Key="PrimaryForegroundColor">#07111F</Color>
    <Color x:Key="BackgroundColor">#0F172A</Color>
    <Color x:Key="ForegroundColor">#F8FAFC</Color>
    <Color x:Key="CardColor">#111827</Color>
    <Color x:Key="CardForegroundColor">#F8FAFC</Color>
    <Color x:Key="SecondaryColor">#1F2937</Color>
    <Color x:Key="SecondaryForegroundColor">#F8FAFC</Color>
    <Color x:Key="MutedColor">#1E293B</Color>
    <Color x:Key="MutedForegroundColor">#94A3B8</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="DestructiveColor">#F87171</Color>
    <Color x:Key="DestructiveForegroundColor">#111827</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>

    <!-- VPN status colors -->
    <Color x:Key="StatusConnectedColor">#34D399</Color>
    <Color x:Key="StatusConnectingColor">#FBBF24</Color>
    <Color x:Key="StatusDisconnectedColor">#64748B</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardForegroundBrush" Color="{StaticResource CardForegroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DestructiveBrush" Color="{StaticResource DestructiveColor}"/>
    <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="{StaticResource DestructiveForegroundColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="StatusConnectedBrush" Color="{StaticResource StatusConnectedColor}"/>
    <SolidColorBrush x:Key="StatusConnectingBrush" Color="{StaticResource StatusConnectingColor}"/>
    <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="{StaticResource StatusDisconnectedColor}"/>

    <!-- Semi-transparent accent brushes -->
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#2960A5FA"/>
    <SolidColorBrush x:Key="PrimaryMediumBrush" Color="#4060A5FA"/>
    <SolidColorBrush x:Key="DestructiveLightBrush" Color="#29F87171"/>
    <SolidColorBrush x:Key="StatusConnectedLightBrush" Color="#2934D399"/>
    <SolidColorBrush x:Key="StatusConnectingLightBrush" Color="#29FBBF24"/>
    <SolidColorBrush x:Key="StatusDisconnectedLightBrush" Color="#2964748B"/>
</ResourceDictionary>
