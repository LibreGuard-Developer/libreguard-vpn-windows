<UserControl x:Class="LibreGuard_VPN_Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:LibreGuard_VPN_Desktop.Models"
             xmlns:controls="clr-namespace:LibreGuard_VPN_Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">

            <!-- ??? Header ??? -->
            <StackPanel Margin="0,0,0,32">
                <TextBlock Text="Settings" Style="{StaticResource HeadingXLStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="Configure your VPN preferences and security options"
                           Style="{StaticResource MutedTextStyle}"/>
            </StackPanel>

            <!-- ??? Main Grid ??? -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0">

                    <!-- ??? Upgrade Card ??? -->
                    <Grid Margin="0,0,0,24">
                        <Border CornerRadius="16" Padding="24"
                                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2"
                                Visibility="{Binding IsProPlan, Converter={StaticResource InverseBoolToVis}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#101570EF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="12"
                                            Background="{DynamicResource PrimaryBrush}">
                                        <TextBlock Text="&#x2B50;" FontSize="28" FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="Upgrade to Pro" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Unlock unlimited data, priority servers, DNS ad blocking, and premium security features"
                                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource PrimaryLightBrush}">
                                            <TextBlock Text="&#x2705;" FontSize="10" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Unlimited bandwidth" Style="{StaticResource SmallMutedTextStyle}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource PrimaryLightBrush}">
                                            <TextBlock Text="&#x2705;" FontSize="10" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Priority servers" Style="{StaticResource SmallMutedTextStyle}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource PrimaryLightBrush}">
                                            <TextBlock Text="&#x2705;" FontSize="10" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Full OpenVPN support" Style="{StaticResource SmallMutedTextStyle}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource PrimaryLightBrush}">
                                            <TextBlock Text="&#x2705;" FontSize="10" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="DNS ad blocking" Style="{StaticResource SmallMutedTextStyle}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </UniformGrid>
                                <Button Content="Upgrade Now" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding UpgradeCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="16" Padding="24"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Background="{DynamicResource BackgroundBrush}"
                                Visibility="{Binding IsProPlan, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="52" Height="52" CornerRadius="14"
                                            Background="{DynamicResource StatusConnectedLightBrush}">
                                        <TextBlock Text="&#x2713;" FontSize="24" FontWeight="Bold"
                                                   Foreground="{DynamicResource StatusConnectedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Pro is active" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Your account already has full access to premium features."
                                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Padding="12,6" CornerRadius="12"
                                            Background="{DynamicResource StatusConnectedLightBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding CurrentPlan, StringFormat={}{0} Plan}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StatusConnectedBrush}"/>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="4">
                                    <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Data" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Unlimited" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="14,12" Margin="4,0">
                                        <StackPanel>
                                            <TextBlock Text="Protocol" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,4"/>
                                            <TextBlock Text="OpenVPN" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="14,12" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Access" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Priority servers" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="14,12" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Connections" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Max 3 Devices" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ??? Preferences ??? -->
                    <TextBlock Text="Preferences" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <TextBlock Text="&#x1F506;" FontSize="22" FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Theme" Style="{StaticResource SubheadingStyle}"/>
                                    <TextBlock Text="Choose your app appearance" Style="{StaticResource SmallMutedTextStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource SegmentedButtonStyle}"
                                             GroupName="ThemePreference"
                                             Margin="0,0,8,0"
                                             IsChecked="{Binding ThemePreference, Converter={StaticResource EqualToBool}, ConverterParameter={x:Static models:AppThemePreference.System}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#x1F506;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="System"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource SegmentedButtonStyle}"
                                             GroupName="ThemePreference"
                                             Margin="4,0"
                                             IsChecked="{Binding ThemePreference, Converter={StaticResource EqualToBool}, ConverterParameter={x:Static models:AppThemePreference.Light}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#x2600;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Margin="0,0,6,0"/>
                                        <TextBlock Text="Light"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource SegmentedButtonStyle}"
                                             GroupName="ThemePreference"
                                             Margin="8,0,0,0"
                                             IsChecked="{Binding ThemePreference, Converter={StaticResource EqualToBool}, ConverterParameter={x:Static models:AppThemePreference.Dark}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#x1F319;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Margin="0,0,6,0"/>
                                        <TextBlock Text="Dark"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ??? Security Settings ??? -->
                    <TextBlock Text="Security Settings" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16"/>
                    <UniformGrid Columns="2" Margin="0,0,0,24">
                        <!-- Two-Factor Auth -->
                        <controls:RippleDecorator Style="{StaticResource RippleCardStyle}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <TextBlock Text="&#x1F512;" FontSize="22" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="Two-Factor Auth" Style="{StaticResource SubheadingStyle}"/>
                                    <TextBlock Text="Extra layer of security" Style="{StaticResource SmallMutedTextStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding TwoFactorAuth}" VerticalAlignment="Center"/>
                            </Grid>
                        </controls:RippleDecorator>

                        <!-- Account-wide DNS Ad Blocking -->
                        <Border Style="{StaticResource CardStyle}" Margin="8,0,0,8">
                            <Grid ClipToBounds="False">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBadgeStyle}">
                                            <TextBlock Text="&#x1F6AB;" FontSize="22"
                                                       FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="Ad Blocking" Style="{StaticResource SubheadingStyle}"/>
                                            <TextBlock Text="Filter ads through private DNS"
                                                       Style="{StaticResource SmallMutedTextStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <!-- Read-only visual: the server response remains authoritative. -->
                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding AdBlockingRequestedEnabled, Mode=OneWay}"
                                                  IsHitTestVisible="False" Focusable="False"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{Binding AdBlockingStatus}"
                                               Style="{StaticResource SmallMutedTextStyle}"
                                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    <ProgressBar Height="2" Margin="0,10,0,0" IsIndeterminate="True"
                                                 Visibility="{Binding IsAdBlockingBusy, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <!-- Enabled accounts toggle by clicking the card; no optimistic binding is used. -->
                                <controls:RippleDecorator Background="Transparent" Cursor="Hand" CornerRadius="12"
                                                          IsEnabled="{Binding CanToggleAdBlocking}"
                                                          Focusable="True" KeyboardNavigation.IsTabStop="True"
                                                          AutomationProperties.Name="Toggle ad blocking">
                                    <controls:RippleDecorator.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleAdBlockingCommand}"/>
                                        <KeyBinding Key="Enter" Command="{Binding ToggleAdBlockingCommand}"/>
                                        <KeyBinding Key="Space" Command="{Binding ToggleAdBlockingCommand}"/>
                                    </controls:RippleDecorator.InputBindings>
                                </controls:RippleDecorator>

                                <!-- Free/unauthorized accounts follow the existing upgrade path. -->
                                <controls:RippleDecorator Background="Transparent" Cursor="Hand" CornerRadius="12"
                                                          Visibility="{Binding IsAdBlockingUpgradeRequired, Converter={StaticResource BoolToVis}}"
                                                          Focusable="True" KeyboardNavigation.IsTabStop="True"
                                                          AutomationProperties.Name="Upgrade to Pro for ad blocking">
                                    <controls:RippleDecorator.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding UpgradeCommand}"/>
                                        <KeyBinding Key="Enter" Command="{Binding UpgradeCommand}"/>
                                        <KeyBinding Key="Space" Command="{Binding UpgradeCommand}"/>
                                    </controls:RippleDecorator.InputBindings>
                                </controls:RippleDecorator>

                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-24,0"
                                        Width="32" Height="20" CornerRadius="4"
                                        Background="{DynamicResource PrimaryBrush}"
                                        IsHitTestVisible="False" BorderBrush="White" BorderThickness="1">
                                    <TextBlock Text="PRO" FontSize="10" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- ??? Default Protocol ??? -->
                    <TextBlock Text="Default Protocol" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <TextBlock Text="&#x1F517;" FontSize="22" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="VPN Protocol" Style="{StaticResource SubheadingStyle}"/>
                                    <TextBlock Text="Choose your tunnel" Style="{StaticResource SmallMutedTextStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- IKEv2/IPSec Option -->
                                <controls:RippleDecorator Grid.Column="0" Margin="0,0,8,0" Cursor="Hand" CornerRadius="8">
                                    <controls:RippleDecorator.Style>
                                        <Style TargetType="{x:Type controls:RippleDecorator}" BasedOn="{StaticResource RippleCardStyle}">
                                            <Setter Property="Padding" Value="16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefaultProtocol}" Value="{x:Static models:VpnProtocol.IKEv2}">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="RippleColor" Value="#33FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:RippleDecorator.Style>
                                    <controls:RippleDecorator.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectIkeProtocolCommand}" />
                                    </controls:RippleDecorator.InputBindings>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="IKEv2/IPSec" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubheadingStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DefaultProtocol, Converter={StaticResource EqualToBool}, ConverterParameter={x:Static models:VpnProtocol.IKEv2}}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Fast &amp; Stable" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SmallMutedTextStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DefaultProtocol, Converter={StaticResource EqualToBool}, ConverterParameter={x:Static models:VpnProtocol.IKEv2}}" Value="True">
                                                            <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </controls:RippleDecorator>
                                <!-- OpenVPN Option -->
                                <controls:RippleDecorator Grid.Column="1" Margin="8,0,0,0" Cursor="Hand" CornerRadius="8" ClipToBounds="False">
                                    <controls:RippleDecorator.Style>
                                        <Style TargetType="{x:Type controls:RippleDecorator}" BasedOn="{StaticResource RippleCardStyle}">
                                            <Setter Property="Padding" Value="16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefaultProtocol}" Value="{x:Static models:VpnProtocol.OpenVPN}">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="RippleColor" Value="#33FFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOpenVpnAvailable}" Value="False">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:RippleDecorator.Style>
                                    <controls:RippleDecorator.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectOpenVpnProtocolCommand}" />
                                    </controls:RippleDecorator.InputBindings>
                                    <Grid ClipToBounds="False">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="OpenVPN" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubheadingStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DefaultProtocol, Converter={StaticResource EqualToBool}, ConverterParameter={x:Static models:VpnProtocol.OpenVPN}}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Open Source" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SmallMutedTextStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DefaultProtocol, Converter={StaticResource EqualToBool}, ConverterParameter={x:Static models:VpnProtocol.OpenVPN}}" Value="True">
                                                                <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- PRO badge in corner -->
                                        <controls:RippleDecorator Visibility="{Binding IsOpenVpnAvailable, Converter={StaticResource InverseBoolToVis}}" 
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-24,0"
                                                Width="32" Height="20" CornerRadius="4" Background="{DynamicResource PrimaryBrush}" 
                                                Cursor="Hand" BorderBrush="White" BorderThickness="1">
                                            <controls:RippleDecorator.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding UpgradeCommand}" />
                                            </controls:RippleDecorator.InputBindings>
                                            <TextBlock Text="PRO" FontSize="10" Foreground="White" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </controls:RippleDecorator>
                                    </Grid>
                                </controls:RippleDecorator>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ??? Connection Settings ??? -->
                    <TextBlock Text="Connection Settings" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16"/>
                    <UniformGrid Columns="2" Margin="0,0,0,24">
                        <!-- Auto-Connect -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <Grid ClipToBounds="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconBadgeStyle}">
                                        <TextBlock Text="&#x1F50C;" FontSize="22" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-Connect" Style="{StaticResource SubheadingStyle}"/>
                                        <TextBlock Text="Connect on System Startup" Style="{StaticResource SmallMutedTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding AutoConnect}" IsEnabled="{Binding IsProPlan}" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Upgrade overlay -->
                                <controls:RippleDecorator Background="Transparent" Cursor="Hand" CornerRadius="12"
                                        Visibility="{Binding IsProPlan, Converter={StaticResource InverseBoolToVis}}">
                                    <controls:RippleDecorator.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding UpgradeCommand}" />
                                    </controls:RippleDecorator.InputBindings>
                                </controls:RippleDecorator>
                                <!-- PRO badge in corner -->
                                <Border Visibility="{Binding IsProPlan, Converter={StaticResource InverseBoolToVis}}" 
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-24,0"
                                        Width="32" Height="20" CornerRadius="4" Background="{DynamicResource PrimaryBrush}" 
                                        IsHitTestVisible="False" BorderBrush="White" BorderThickness="1">
                                    <TextBlock Text="PRO" FontSize="10" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Kill Switch -->
                        <Border Style="{StaticResource CardStyle}" Margin="8,0,0,8">
                            <Grid ClipToBounds="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconBadgeStyle}">
                                        <TextBlock Text="&#x1F6E1;" FontSize="22" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="Kill Switch" Style="{StaticResource SubheadingStyle}"/>
                                        <TextBlock Text="Block if VPN drops" Style="{StaticResource SmallMutedTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding KillSwitch}" IsEnabled="{Binding IsProPlan}" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Upgrade overlay -->
                                <controls:RippleDecorator Background="Transparent" Cursor="Hand" CornerRadius="12"
                                        Visibility="{Binding IsProPlan, Converter={StaticResource InverseBoolToVis}}">
                                    <controls:RippleDecorator.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding UpgradeCommand}" />
                                    </controls:RippleDecorator.InputBindings>
                                </controls:RippleDecorator>
                                <!-- PRO badge in corner -->
                                <Border Visibility="{Binding IsProPlan, Converter={StaticResource InverseBoolToVis}}" 
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-24,0"
                                        Width="32" Height="20" CornerRadius="4" Background="{DynamicResource PrimaryBrush}" 
                                        IsHitTestVisible="False" BorderBrush="White" BorderThickness="1">
                                    <TextBlock Text="PRO" FontSize="10" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Notifications -->
                        <controls:RippleDecorator Style="{StaticResource RippleCardStyle}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <TextBlock Text="&#x1F514;" FontSize="22" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="Notifications" Style="{StaticResource SubheadingStyle}"/>
                                    <TextBlock Text="Status alerts" Style="{StaticResource SmallMutedTextStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Notifications}" VerticalAlignment="Center"/>
                            </Grid>
                        </controls:RippleDecorator>
                    </UniformGrid>
                </StackPanel>

                <!-- RIGHT COLUMN -->
                <StackPanel Grid.Column="2">

                    <!-- Support & Legal -->
                    <TextBlock Text="Support &amp; Legal" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16"/>
                    <StackPanel Margin="0,0,0,24">
                        <controls:RippleDecorator Style="{StaticResource RippleCardStyle}" Margin="0,0,0,12" Cursor="Hand">
                            <controls:RippleDecorator.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenHelpAndSupportCommand}" />
                            </controls:RippleDecorator.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x2753;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="Help &amp; Support" Style="{StaticResource SubheadingStyle}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="&gt;" FontSize="20"
                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </controls:RippleDecorator>
                        <controls:RippleDecorator Style="{StaticResource RippleCardStyle}" Margin="0,0,0,12" Cursor="Hand">
                            <controls:RippleDecorator.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenPrivacyPolicyCommand}" />
                            </controls:RippleDecorator.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x1F512;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="Privacy Policy" Style="{StaticResource SubheadingStyle}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="&gt;" FontSize="20"
                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </controls:RippleDecorator>
                        <controls:RippleDecorator Style="{StaticResource RippleCardStyle}" Cursor="Hand">
                            <controls:RippleDecorator.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenTermsOfServiceCommand}" />
                            </controls:RippleDecorator.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x1F4C4;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="Terms of Service" Style="{StaticResource SubheadingStyle}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="&gt;" FontSize="20"
                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </controls:RippleDecorator>
                        <controls:RippleDecorator Style="{StaticResource RippleCardStyle}" Margin="0,12,0,0" Cursor="Hand">
                            <controls:RippleDecorator.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSourceLicensesCommand}" />
                            </controls:RippleDecorator.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x1F517;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="Open Source Licenses" Style="{StaticResource SubheadingStyle}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="&gt;" FontSize="20"
                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </controls:RippleDecorator>
                    </StackPanel>

                    <!-- About -->
                    <controls:RippleDecorator Style="{StaticResource RippleCardStyle}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="About LibreGuard" Style="{StaticResource SubheadingStyle}" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Version" Style="{StaticResource SmallMutedTextStyle}"/>
                                <TextBlock Text="{Binding AppVersion}" HorizontalAlignment="Right" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ForegroundBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Platform" Style="{StaticResource SmallMutedTextStyle}"/>
                                <TextBlock Text="Desktop" HorizontalAlignment="Right" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ForegroundBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="License" Style="{StaticResource SmallMutedTextStyle}"/>
                                <TextBlock Text="Open Source" HorizontalAlignment="Right" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ForegroundBrush}"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Margin="0,8,0,0" Padding="0,12,0,0">
                                <TextBlock Text="Privacy-focused VPN built with care"
                                           Style="{StaticResource SmallMutedTextStyle}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </controls:RippleDecorator>

                    <!-- Account -->
                    <TextBlock Text="Account" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16"/>
                    <controls:RippleDecorator Style="{StaticResource RippleCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="48" Height="48" CornerRadius="24"
                                        Background="{DynamicResource PrimaryLightBrush}">
                                    <TextBlock Text="&#x1F464;" FontSize="22" Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Emoji, Segoe UI Symbol"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding UserEmail}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Border Grid.Column="1" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                                                Width="18" Height="18" CornerRadius="9"
                                                Background="{DynamicResource StatusConnectedBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="?" FontSize="10" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding CurrentPlan, StringFormat={}{0} Plan}"
                                                   Style="{StaticResource SmallMutedTextStyle}"/>
                                        <TextBlock Text=" | " Style="{StaticResource SmallMutedTextStyle}" Margin="8,0"/>
                                        <TextBlock Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" 
                                                   Text="Logged In" Style="{StaticResource SmallMutedTextStyle}" 
                                                    Foreground="{DynamicResource StatusConnectedBrush}"/>
                                        <TextBlock Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}" 
                                                   Text="Not Logged In" Style="{StaticResource SmallMutedTextStyle}" 
                                                   Foreground="{DynamicResource DestructiveBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Manage Account" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenManageAccountCommand}"/>
                        </StackPanel>
                    </controls:RippleDecorator>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
