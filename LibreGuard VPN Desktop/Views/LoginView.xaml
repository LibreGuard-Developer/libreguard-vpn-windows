<UserControl x:Class="LibreGuard_VPN_Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="680">

    <Grid>
        <Grid.Resources>
            <!-- Radial gradient opacity mask to fade edges and hide white halo -->
            <RadialGradientBrush x:Key="LogoOpacityMask" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="White" Offset="0"/>
                <GradientStop Color="White" Offset="0.97"/>
                <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side - Branding -->
        <Border Grid.Column="0" CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#191570EF" Offset="0"/>
                    <GradientStop Color="#0D1570EF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="48" LastChildFill="True">
                <!-- Bottom tagline -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="Open source under GPLv2 or later | Built with transparency in mind"
                           Style="{StaticResource SmallMutedTextStyle}" Margin="0,24,0,0"/>

                <StackPanel VerticalAlignment="Top">
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,48">
                        <Border Width="64" Height="64" CornerRadius="12"
                                Background="{DynamicResource PrimaryLightBrush}">
                            <Image Source="pack://application:,,,/Assets/Images/LibreGuard_logo_cropped_V3.ico"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Aliased"
                                   OpacityMask="{StaticResource LogoOpacityMask}"
                                   SnapsToDevicePixels="True"
                                   Margin="8"/>
                        </Border>
                        <TextBlock Text="LibreGuard" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Title -->
                    <TextBlock Text="Privacy-First VPN Protection"
                               FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,24"/>

                    <TextBlock Text="Secure your connection with military-grade encryption and browse freely without tracking."
                               FontSize="16" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,32"/>

                    <!-- Feature list -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource PrimaryLightBrush}">
                                <TextBlock Text="&#x2705;" FontSize="12" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No-logs policy"
                                       Style="{StaticResource MutedTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource PrimaryLightBrush}">
                                <TextBlock Text="&#x2705;" FontSize="12" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="5GB Monthly on Free, Unlimited bandwidth on Pro plan"
                                       Style="{StaticResource MutedTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource PrimaryLightBrush}">
                                <TextBlock Text="&#x2705;" FontSize="12" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Connect 1 device on Free or up to 3 devices simultaneously on Pro."
                                       Style="{StaticResource MutedTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource PrimaryLightBrush}">
                                <TextBlock Text="&#x2705;" FontSize="12" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Cross-platform support"
                                       Style="{StaticResource MutedTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource PrimaryLightBrush}">
                                <TextBlock Text="&#x2705;" FontSize="12" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Open source"
                                       Style="{StaticResource MutedTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Side - Login Form -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <StackPanel VerticalAlignment="Center" Margin="48" MaxWidth="400">
                <!-- Header -->
                <TextBlock Text="Welcome Back" Style="{StaticResource HeadingXLStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="Sign in to your account to continue"
                           Style="{StaticResource MutedTextStyle}" Margin="0,0,0,32"/>

                <!-- Email -->
                <TextBlock Text="Email Address" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="&#x1F4E7;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <!-- Password -->
                <TextBlock Text="Password" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <PasswordBox Style="{StaticResource FormPasswordBoxStyle}" x:Name="PasswordBox"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="&#x1F512;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>

                    <!-- Toggle visibility button -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="8"
                            HorizontalContentAlignment="Center"
                            Command="{Binding TogglePasswordVisibilityCommand}">
                        <Grid>
                            <TextBlock Text="&#x1F441;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" 
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Border Background="{DynamicResource MutedForegroundBrush}" Height="2" Width="20" 
                                    RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-45"/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Forgot password -->
                <Button Content="Forgot password?"
                        Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding GoToForgotPasswordCommand}"
                        Margin="0,0,0,24"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Margin="0,0,0,16"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Sign In -->
                <Grid Margin="0,0,0,24">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                            Visibility="{Binding LoginCommand.IsRunning, Converter={StaticResource InverseBoolToVis}}">
                        <Button.Content>
                            <TextBlock Text="Sign In" FontSize="16" FontWeight="Medium"/>
                        </Button.Content>
                    </Button>
                    <Button Style="{StaticResource DestructiveGhostButtonStyle}" 
                            Command="{Binding CancelLoginCommand}"
                            Visibility="{Binding LoginCommand.IsRunning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cancel Signing In" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Divider -->
                <Grid Margin="0,0,0,24">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="Or continue with"
                               Style="{StaticResource SmallMutedTextStyle}"
                               HorizontalAlignment="Center"
                               Background="{DynamicResource BackgroundBrush}"
                               Padding="16,0"/>
                </Grid>

                <!-- Google -->
                <Grid Margin="0,0,0,24">
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding LoginWithGoogleCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                            Visibility="{Binding IsGoogleSignInRunning, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="G" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Sign in with Google" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DestructiveGhostButtonStyle}" 
                            Command="{Binding CancelGoogleLoginCommand}"
                            Visibility="{Binding IsGoogleSignInRunning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cancel Google Sign In" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="(Opening Browser...)" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Register link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Don't have an account? " Style="{StaticResource MutedTextStyle}"/>
                    <Button Content="Sign up" Style="{StaticResource LinkButtonStyle}"
                            Command="{Binding GoToRegisterCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2FA Overlay -->
        <Grid Grid.ColumnSpan="2" 
              Visibility="{Binding IsTwoFactorRequired, Converter={StaticResource BoolToVis}}"
              Background="#80000000">
            <Border Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400">
                <StackPanel>
                    <TextBlock Text="Two-Factor Authentication" Style="{StaticResource HeadingLargeStyle}" Margin="0,0,0,12"/>
                    <TextBlock Text="Enter the 6-digit code from your authenticator app." 
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <TextBlock Text="Verification Code" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding TwoFactorCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Padding="16,12,16,12"
                             HorizontalContentAlignment="Center"
                             FontSize="20"
                             FontWeight="SemiBold"
                             MaxLength="6"
                             Margin="0,0,0,24"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource ErrorBrush}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Margin="0,0,0,16"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Cancel" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelTwoFactorCommand}"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding VerifyTwoFactorCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                                Margin="8,0,0,0">
                             <Button.Content>
                                <TextBlock FontSize="16" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Verify"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="Text" Value="Verifying..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Device Limit Overlay -->
        <Grid Grid.ColumnSpan="2" 
              Visibility="{Binding IsDeviceLimitReached, Converter={StaticResource BoolToVis}}"
              Background="#80000000">
            <Border Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="450">
                <StackPanel>
                    <TextBlock Text="Device Limit Reached" Style="{StaticResource HeadingLargeStyle}" Margin="0,0,0,12"/>
                    <TextBlock Text="You have reached the maximum number of active devices for your plan. Please select a device to remove before continuing." 
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <ListBox ItemsSource="{Binding Devices}" 
                             SelectedItem="{Binding SelectedDeviceToRemove}"
                             Background="Transparent"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource BorderBrush}"
                             MaxHeight="200"
                             Margin="0,0,0,24"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8">
                                    <TextBlock Text="{Binding DeviceNickname}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{Binding AppVersion, StringFormat='App Version: {0}'}" Style="{StaticResource SmallMutedTextStyle}"/>
                                    <TextBlock Text="{Binding LastSeenAt, StringFormat='Last Seen: {0:g}'}" Style="{StaticResource SmallMutedTextStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource ErrorBrush}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Margin="0,0,0,16"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Cancel" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDeviceRemovalCommand}"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RemoveDeviceCommand}"
                                IsEnabled="{Binding SelectedDeviceToRemove, Converter={StaticResource NullToBool}}"
                                Margin="8,0,0,0">
                             <Button.Content>
                                <TextBlock FontSize="16" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Remove Device"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="Text" Value="Removing..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
