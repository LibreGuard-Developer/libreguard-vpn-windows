<UserControl x:Class="LibreGuard_VPN_Desktop.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:LibreGuard_VPN_Desktop.Converters"
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="720">

    <Grid>
        <Grid.Resources>
            <converters:PasswordStrengthToBrushConverter x:Key="StrengthToBrush"/>
            <!-- Radial gradient opacity mask to fade edges and hide white halo -->
            <RadialGradientBrush x:Key="LogoOpacityMask" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="White" Offset="0"/>
                <GradientStop Color="White" Offset="0.97"/>
                <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side - Branding -->
        <Border Grid.Column="0" CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#191570EF" Offset="0"/>
                    <GradientStop Color="#0D1570EF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="48" LastChildFill="True">
                <TextBlock DockPanel.Dock="Bottom"
                           Text="Join millions protecting their privacy online"
                           Style="{StaticResource SmallMutedTextStyle}" Margin="0,24,0,0"/>

                <StackPanel VerticalAlignment="Top">
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,48">
                        <Border Width="64" Height="64" CornerRadius="12"
                                Background="{DynamicResource PrimaryLightBrush}">
                            <Image Source="pack://application:,,,/Assets/Images/LibreGuard_logo_cropped_V3.ico"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Aliased"
                                   OpacityMask="{StaticResource LogoOpacityMask}"
                                   SnapsToDevicePixels="True"
                                   Margin="8"/>
                        </Border>
                        <TextBlock Text="LibreGuard" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Start Your Privacy Journey"
                               FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,24"/>

                    <TextBlock Text="Create your account and get instant access to secure, encrypted browsing across all your devices."
                               FontSize="16" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,32"/>

                    <!-- Feature list -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource PrimaryLightBrush}">
                                <TextBlock Text="&#x2705;" FontSize="12" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Free plan with 3 server locations"
                                       Style="{StaticResource MutedTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource PrimaryLightBrush}">
                                <TextBlock Text="&#x2705;" FontSize="12" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No credit card required to start"
                                       Style="{StaticResource MutedTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource PrimaryLightBrush}">
                                <TextBlock Text="&#x2705;" FontSize="12" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Upgrade anytime for full access"
                                       Style="{StaticResource MutedTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Side - Register Form -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" Margin="48" MaxWidth="400">
                    <!-- Header -->
                    <TextBlock Text="Create Account" Style="{StaticResource HeadingXLStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="Sign up to get started with LibreGuard VPN"
                               Style="{StaticResource MutedTextStyle}" Margin="0,0,0,32"/>

                    <!-- Email -->
                    <TextBlock Text="Email Address" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="&#x1F4E7;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                    <!-- Password -->
                    <TextBlock Text="Password" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,12">
                        <PasswordBox Style="{StaticResource FormPasswordBoxStyle}" x:Name="PasswordBox"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}}"/>
                        <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="&#x1F512;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                        
                        <!-- Toggle visibility button -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="8"
                                HorizontalContentAlignment="Center"
                                Command="{Binding TogglePasswordVisibilityCommand}">
                            <Grid>
                                <TextBlock Text="&#x1F441;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" 
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <Border Background="{DynamicResource MutedForegroundBrush}" Height="2" Width="20" 
                                        RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-45"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Password Difficulty and Policy -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Password Strength" Style="{StaticResource SmallMutedTextStyle}"/>
                            <TextBlock HorizontalAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SmallMutedTextStyle}">
                                        <Setter Property="Text" Value="Weak"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPasswordEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PasswordStrength.IsValid}" Value="True">
                                                <Setter Property="Text" Value="Strong"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StatusConnectedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ProgressBar Value="{Binding PasswordStrength.Score, Mode=OneWay}" 
                                     Foreground="{Binding PasswordStrength.Score, Converter={StaticResource StrengthToBrush}}"
                                     Background="{DynamicResource MutedBrush}"
                                     BorderThickness="0" Height="4" Maximum="100"/>
                        <TextBlock Text="Password must be at least 8 characters and include a number and a special character."
                                   Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Confirm Password -->
                    <TextBlock Text="Confirm Password" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <PasswordBox Style="{StaticResource FormPasswordBoxStyle}" x:Name="ConfirmPasswordBox"
                                     Visibility="{Binding IsConfirmPasswordVisible, Converter={StaticResource InverseBoolToVis}}"/>
                        <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsConfirmPasswordVisible, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="&#x1F512;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>

                        <!-- Toggle visibility button -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="8"
                                HorizontalContentAlignment="Center"
                                Command="{Binding ToggleConfirmPasswordVisibilityCommand}">
                            <Grid>
                                <TextBlock Text="&#x1F441;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" 
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <Border Background="{DynamicResource MutedForegroundBrush}" Height="2" Width="20" 
                                        RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-45"/>
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfirmPasswordVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Password match error -->
                    <TextBlock Text="Passwords do not match." Foreground="{DynamicResource ErrorBrush}" FontSize="12" Margin="0,-16,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SmallMutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPasswordMatch}" Value="False"/>
                                            <Condition Binding="{Binding ConfirmPassword.Length, Converter={StaticResource EqualToBool}, ConverterParameter=0}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Legal agreement text -->
                    <TextBlock Margin="0,0,0,24" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="By using the services you agree to our "/>
                        <Hyperlink Command="{Binding OpenTermsOfServiceCommand}" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None">Terms of Service</Hyperlink>
                        <Run Text=" and "/>
                        <Hyperlink Command="{Binding OpenPrivacyPolicyCommand}" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None">Privacy Policy</Hyperlink>
                    </TextBlock>

                    <!-- Create Account -->
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                            Margin="0,0,0,24">
                        <Button.Content>
                            <TextBlock FontSize="16" FontWeight="Medium">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Create Account"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="Text" Value="Creating account..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <!-- Divider -->
                    <Grid Margin="0,0,0,24">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Or continue with"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   HorizontalAlignment="Center"
                                   Background="{DynamicResource BackgroundBrush}"
                                   Padding="16,0"/>
                    </Grid>

                    <!-- Google -->
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="G" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Continue with Google" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Login link -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Already have an account? " Style="{StaticResource MutedTextStyle}"/>
                        <Button Content="Sign in" Style="{StaticResource LinkButtonStyle}"
                                Command="{Binding GoToLoginCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
