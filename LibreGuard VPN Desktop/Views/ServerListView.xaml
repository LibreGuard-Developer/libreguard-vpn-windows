<UserControl x:Class="LibreGuard_VPN_Desktop.Views.ServerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LibreGuard_VPN_Desktop.Controls"
             mc:Ignorable="d"
                      d:DesignWidth="800" d:DesignHeight="700"
                      Loaded="OnLoaded">

             <UserControl.Resources>
                 <Style x:Key="ServerCardButtonStyle" TargetType="Button">
                     <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                     <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                     <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                    <Setter Property="Padding" Value="16"/>
                    <Setter Property="Margin" Value="4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                     <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                     <Setter Property="Template">
                         <Setter.Value>
                             <ControlTemplate TargetType="Button">
                                 <controls:RippleDecorator x:Name="border" 
                                         Background="{TemplateBinding Background}" 
                                         BorderBrush="{TemplateBinding BorderBrush}" 
                                         BorderThickness="{TemplateBinding BorderThickness}" 
                                         CornerRadius="12" 
                                         ClipToBounds="True"
                                         SnapsToDevicePixels="True">
                                     <ContentPresenter x:Name="contentPresenter" 
                                                       Focusable="False" 
                                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                       Margin="{TemplateBinding Padding}" 
                                                       RecognizesAccessKey="True" 
                                                       SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                 </controls:RippleDecorator>
                                 <ControlTemplate.Triggers>
                                     <Trigger Property="IsMouseOver" Value="True">
                                         <Setter TargetName="border" Property="Background" Value="{DynamicResource MutedBrush}"/>
                                         <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                     </Trigger>
                                     <Trigger Property="IsPressed" Value="True">
                                         <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryBrush}"/>
                                     </Trigger>
                                 </ControlTemplate.Triggers>
                             </ControlTemplate>
                         </Setter.Value>
                     </Setter>
                 </Style>

                 <Style x:Key="RefreshButtonStyle" TargetType="Button">
                     <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                     <Setter Property="Foreground" Value="White"/>
                     <Setter Property="Padding" Value="12"/>
                     <Setter Property="BorderThickness" Value="0"/>
                     <Setter Property="Cursor" Value="Hand"/>
                     <Setter Property="Template">
                         <Setter.Value>
                             <ControlTemplate TargetType="Button">
                                 <controls:RippleDecorator x:Name="Bd"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"
                                         CornerRadius="12"
                                         Padding="{TemplateBinding Padding}"
                                         SnapsToDevicePixels="True"
                                         RenderTransformOrigin="0.5,0.5">
                                     <controls:RippleDecorator.RenderTransform>
                                         <ScaleTransform ScaleX="1" ScaleY="1"/>
                                     </controls:RippleDecorator.RenderTransform>
                                     <Path x:Name="IconPath"
                                           Width="18"
                                           Height="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform"
                                           Fill="{TemplateBinding Foreground}"
                                           Data="M 12 2 A 10 10 0 1 0 22 12 L 20 12 A 8 8 0 1 1 12 4 V 1 L 16 5 L 12 9 Z"
                                           RenderTransformOrigin="0.5,0.5">
                                         <Path.RenderTransform>
                                             <RotateTransform Angle="0"/>
                                         </Path.RenderTransform>
                                     </Path>
                                 </controls:RippleDecorator>
                                 <ControlTemplate.Triggers>
                                     <Trigger Property="IsMouseOver" Value="True">
                                         <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                     </Trigger>
                                     <Trigger Property="IsPressed" Value="True">
                                         <Trigger.EnterActions>
                                             <BeginStoryboard>
                                                 <Storyboard>
                                                     <DoubleAnimation Storyboard.TargetName="Bd"
                                                                      Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                      To="0.95"
                                                                      Duration="0:0:0.1"/>
                                                     <DoubleAnimation Storyboard.TargetName="Bd"
                                                                      Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                      To="0.95"
                                                                      Duration="0:0:0.1"/>
                                                 </Storyboard>
                                             </BeginStoryboard>
                                         </Trigger.EnterActions>
                                         <Trigger.ExitActions>
                                             <BeginStoryboard>
                                                 <Storyboard>
                                                     <DoubleAnimation Storyboard.TargetName="Bd"
                                                                      Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                      To="1"
                                                                      Duration="0:0:0.1"/>
                                                     <DoubleAnimation Storyboard.TargetName="Bd"
                                                                      Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                      To="1"
                                                                      Duration="0:0:0.1"/>
                                                 </Storyboard>
                                             </BeginStoryboard>
                                         </Trigger.ExitActions>
                                     </Trigger>
                                     <EventTrigger RoutedEvent="Button.Click">
                                         <BeginStoryboard>
                                             <Storyboard>
                                                 <DoubleAnimation Storyboard.TargetName="IconPath"
                                                                  Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                  From="0"
                                                                  To="360"
                                                                  Duration="0:0:0.55"
                                                                  FillBehavior="Stop"/>
                                             </Storyboard>
                                         </BeginStoryboard>
                                     </EventTrigger>
                                     <Trigger Property="IsEnabled" Value="False">
                                         <Setter Property="Opacity" Value="0.5"/>
                                     </Trigger>
                                 </ControlTemplate.Triggers>
                             </ControlTemplate>
                         </Setter.Value>
                     </Setter>
                 </Style>
             </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">

            <!-- ??? Header ??? -->
            <Grid Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Server Locations" Style="{StaticResource HeadingXLStyle}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource MutedTextStyle}">
                        <Run Text="Choose from "/>
                        <Run Text="{Binding TotalServerCount, Mode=OneWay}"/>
                        <Run Text=" servers in "/>
                        <Run Text="{Binding CountryCount, Mode=OneWay}"/>
                        <Run Text=" countries"/>
                    </TextBlock>
                </StackPanel>

                <!-- Protocol selector -->
                <Border Grid.Column="1" CornerRadius="12" Padding="4"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedButtonStyle}"
                                     GroupName="Protocol"
                                     IsChecked="{Binding SelectedProtocol, Converter={StaticResource EqualToBool}, ConverterParameter=IKEv2}"
                                     Content="IKEv2/IPSec"/>
                        <RadioButton Style="{StaticResource SegmentedButtonStyle}"
                                     GroupName="Protocol"
                                     IsChecked="{Binding SelectedProtocol, Converter={StaticResource EqualToBool}, ConverterParameter=OpenVPN}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="OpenVPN" VerticalAlignment="Center"/>
                                <TextBlock Text="&#x1F512;" FontSize="12" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsOpenVpnAvailable, Converter={StaticResource InverseBoolToVis}}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ??? Search & Controls ??? -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="&#x1F50D;" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    <!-- Placeholder -->
                    <TextBlock Text="Search servers, cities, or countries..."
                               FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center" Margin="42,0,0,0" IsHitTestVisible="False"
                               Opacity="0.6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Sort dropdown -->
                <ComboBox Grid.Column="2" Style="{StaticResource FormComboBoxStyle}" Width="160"
                          SelectedValuePath="Tag" SelectedValue="{Binding SortBy}">
                    <ComboBoxItem Content="Ping" Tag="ping"/>
                    <ComboBoxItem Content="Load" Tag="load"/>
                    <ComboBoxItem Content="Name" Tag="name"/>
                </ComboBox>

                <!-- Refresh -->
                <Button Grid.Column="4" Style="{StaticResource RefreshButtonStyle}"
                        Command="{Binding RefreshServersCommand}" Padding="12">
                    <TextBlock Text="&#x21BB;" FontSize="18" FontFamily="Segoe UI Symbol"/>
                </Button>
            </Grid>

            <!-- ??? Favourites Section ??? -->
            <StackPanel x:Name="FavouritesSection"
                        Margin="0,0,0,28">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FavoriteServers.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Heading row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FavouritesStar" Text="&#x2605;" FontSize="16" FontFamily="Segoe UI, Arial"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Favourites" Style="{StaticResource HeadingStyle}" Margin="0"/>
                    </StackPanel>
                </Grid>

                <!-- Favourite server cards -->
                <ItemsControl x:Name="FavouritesItemsControl" ItemsSource="{Binding FavoriteServers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- Each new card slides down from above with a back-ease bounce + fades in -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                From="-36" To="0" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="0" To="1" Duration="0:0:0.28"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ServerCardButtonStyle}"
                                    Command="{Binding DataContext.SelectServerCommand, ElementName=FavouritesItemsControl}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Flag Container -->
                                        <Grid Margin="0,0,12,0" VerticalAlignment="Center" Width="32" Height="24" ClipToBounds="True">
                                            <Viewbox Visibility="{Binding FlagUrl, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverted}"
                                                     Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Flag}" FontSize="24"
                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Viewbox>
                                            <Viewbox Visibility="{Binding FlagUrl, Converter={StaticResource NullToVisibility}}"
                                                     Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Image Source="{Binding FlagUrl}"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            </Viewbox>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding City}" FontSize="14" FontWeight="Medium"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <Border Visibility="{Binding IsPremium, Converter={StaticResource BoolToVis}}"
                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource PrimaryLightBrush}" CornerRadius="4" Padding="4,1">
                                                    <TextBlock Text="PRO" Foreground="{DynamicResource PrimaryBrush}"
                                                               FontSize="9" FontWeight="Bold" FontFamily="{StaticResource BrandFont}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ServerName}" Style="{StaticResource SmallMutedTextStyle}"/>
                                        </StackPanel>

                                        <!-- Favourite star (always blue here) -->
                                        <Button Grid.Column="2" Padding="6" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand"
                                                Click="FavouritesStarButton_Click">
                                            <TextBlock Text="&#x2605;" FontSize="18"
                                                       FontFamily="Segoe UI, Arial"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Button>
                                    </Grid>

                                    <!-- Stats row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" FontSize="13" FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                   Foreground="{Binding PingMs, Converter={StaticResource PingToBrush}}">
                                            <Run Text="&#x1F4F6; "/><Run Text="{Binding PingMs, Mode=OneWay}"/><Run Text="ms"/>
                                        </TextBlock>

                                        <ProgressBar Grid.Column="2"
                                                     Style="{StaticResource DataUsageProgressStyle}"
                                                     Value="{Binding LoadPercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Foreground="{Binding LoadPercent, Converter={StaticResource LoadToBrush}}"
                                                     VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Divider -->
                <Separator Margin="0,24,0,0" Background="{DynamicResource BorderBrush}"/>
            </StackPanel>

            <!-- ??? Server List ??? -->
            <TextBlock Text="All Servers" Style="{StaticResource HeadingStyle}" Margin="0,0,0,16"/>

            <ItemsControl x:Name="ServerItemsControl" ItemsSource="{Binding GroupedServers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,16"
                                Padding="16"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Margin="0,0,12,0" VerticalAlignment="Center" Width="32" Height="24">
                                        <TextBlock Text="{Binding Flag}" FontSize="24"
                                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding FlagUrl, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverted}"/>
                                        <Image Source="{Binding FlagUrl}" Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding FlagUrl, Converter={StaticResource NullToVisibility}}">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,32,24" RadiusX="2" RadiusY="2"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Country}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding ServerSummary}"
                                                   Style="{StaticResource SmallMutedTextStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Servers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ServerCardButtonStyle}"
                                                    Command="{Binding DataContext.SelectServerCommand, ElementName=ServerItemsControl}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Margin="0,0,12,0" VerticalAlignment="Center" Width="32" Height="24">
                                                            <TextBlock Text="{Binding Flag}" FontSize="24"
                                                                       FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding FlagUrl, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverted}"/>
                                                            <Image Source="{Binding FlagUrl}" Stretch="Fill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding FlagUrl, Converter={StaticResource NullToVisibility}}">
                                                                <Image.Clip>
                                                                    <RectangleGeometry Rect="0,0,32,24" RadiusX="2" RadiusY="2"/>
                                                                </Image.Clip>
                                                            </Image>
                                                        </Grid>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding City}" FontSize="14" FontWeight="Medium"
                                                                           Foreground="{DynamicResource ForegroundBrush}"/>

                                                                <Border Visibility="{Binding IsPremium, Converter={StaticResource BoolToVis}}"
                                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                                        Background="{DynamicResource PrimaryLightBrush}" CornerRadius="4" Padding="4,1">
                                                                    <TextBlock Text="PRO" Foreground="{DynamicResource PrimaryBrush}"
                                                                               FontSize="9" FontWeight="Bold" FontFamily="{StaticResource BrandFont}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ServerName}" Style="{StaticResource SmallMutedTextStyle}"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="2" Padding="6" Background="Transparent"
                                                                BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=ServerItemsControl}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="&#x2605;" FontSize="18"
                                                                       FontFamily="Segoe UI, Arial">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground">
                                                                            <Setter.Value>
                                                                                <SolidColorBrush Color="#64748B"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Setter Property="Opacity" Value="0.4"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <ColorAnimation
                                                                                                Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                                                To="#1570EF" Duration="0:0:0.25"/>
                                                                                            <DoubleAnimation
                                                                                                Storyboard.TargetProperty="Opacity"
                                                                                                To="1" Duration="0:0:0.2"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                                <DataTrigger.ExitActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <ColorAnimation
                                                                                                Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                                                To="#64748B" Duration="0:0:0.25"/>
                                                                                            <DoubleAnimation
                                                                                                Storyboard.TargetProperty="Opacity"
                                                                                                To="0.4" Duration="0:0:0.2"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.ExitActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" FontSize="13" FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                                                   Foreground="{Binding PingMs, Converter={StaticResource PingToBrush}}">
                                                            <Run Text="&#x1F4F6; "/><Run Text="{Binding PingMs, Mode=OneWay}"/><Run Text="ms"/>
                                                        </TextBlock>

                                                        <ProgressBar Grid.Column="2"
                                                                     Style="{StaticResource DataUsageProgressStyle}"
                                                                     Value="{Binding LoadPercent, Mode=OneWay}"
                                                                     Maximum="100"
                                                                     Foreground="{Binding LoadPercent, Converter={StaticResource LoadToBrush}}"
                                                                     VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- No results -->
            <StackPanel HorizontalAlignment="Center" Margin="0,48,0,0"
                        Visibility="{Binding GroupedServers.Count, Converter={StaticResource EqualToVis}, ConverterParameter=0}">
                <TextBlock Text="&#x1F50D;" FontSize="48" FontFamily="Segoe UI Emoji, Segoe UI Symbol" HorizontalAlignment="Center" Margin="0,0,0,16"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                <TextBlock Text="No servers found" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="Try adjusting your search query" Style="{StaticResource SmallMutedTextStyle}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <!-- Overlay canvas: animation particles fly here, never blocks hit-testing -->
    <Canvas x:Name="AnimationOverlay" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
