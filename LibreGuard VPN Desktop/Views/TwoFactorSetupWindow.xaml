<Window x:Class="LibreGuard_VPN_Desktop.Views.TwoFactorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibreGuard_VPN_Desktop.Views"
        mc:Ignorable="d"
        Title="LibreGuard VPN - Two-Factor Authentication" 
        Height="700" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <local:TwoFactorSetupModalView x:Name="SetupView"/>
</Window>
