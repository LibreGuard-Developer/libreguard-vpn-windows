<Window x:Class="LibreGuard_VPN_Desktop.Views.CardCheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Secure Card Checkout"
        Width="980" Height="760"
        MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/Images/LibreGuard_logo_cropped_V3.ico"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Secure Card Checkout" Style="{StaticResource HeadingStyle}"/>
                    <TextBlock Text="Your payment details are handled securely by Creem."
                               Style="{StaticResource SmallMutedTextStyle}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Close &amp; Open in Browser" Style="{StaticResource GhostButtonStyle}"
                            Click="CloseAndOpenInBrowserButton_Click" Margin="0,0,8,0"/>
                    <Button Content="Close" Style="{StaticResource GhostButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="CheckoutBrowser"/>
            <Border x:Name="LoadingOverlay" Background="{DynamicResource BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="5"
                                 Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Opening secure checkout..." Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
